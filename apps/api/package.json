{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Mini Wine Cellar GraphQL API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "migration:create": "mikro-orm migration:create --config ./mikro-orm.config.ts",
    "migration:up": "mikro-orm migration:up --config ./mikro-orm.config.ts",
    "migration:down": "mikro-orm migration:down --config ./mikro-orm.config.ts",
    "seed": "tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@mikro-orm/core": "7.2.6",
    "@mikro-orm/decorators": "7.2.6",
    "@mikro-orm/migrations": "7.2.6",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.6",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "16.14.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@mikro-orm/cli": "7.2.6",
    "@nestjs/cli": "11.0.24",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "mikro-orm": {
    "preferTs": true,
    "tsLoader": "tsx"
  }
}
